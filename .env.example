# Ask Youssef AI — safe configuration template
# Copy to .env for local/Docker use. Never commit real secrets.

# Generation provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=24
GEMINI_RETRIES=2

# Semantic retrieval — production-compatible local FastEmbed configuration
EMBEDDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# Optional contact action
FORMSPREE_ENDPOINT=

# Synchronized portfolio knowledge
CRAWL_SITES=
CORPUS_DIR=backend/data/site
MCP_TRANSPORT=inprocess

# Browser/API boundaries
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,https://youssef-bt.github.io
MAX_QUESTION_CHARS=600
MAX_TURN_CHARS=600
RATE_PER_MIN=6
RATE_PER_DAY=40
GLOBAL_PER_DAY=800
