# Ask Youssef AI — safe configuration template
# Copy to .env locally. Never commit real secrets.

# Generation provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=45
GEMINI_RETRIES=4

# Semantic embeddings
EMBEDDER=gemini
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_EMBED_DIM=768
GEMINI_EMBED_PER_MIN=50
GEMINI_EMBED_COOLDOWN=60
GEMINI_EMBED_RETRIES=5

# Optional contact action
FORMSPREE_ENDPOINT=

# Synchronized portfolio knowledge
CRAWL_SITES=
CORPUS_DIR=backend/data/site
EMBED_CACHE_DIR=backend/data/embcache
MCP_TRANSPORT=inprocess

# Browser/API boundaries
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,https://youssef-bt.github.io
MAX_QUESTION_CHARS=600
MAX_TURN_CHARS=600
RATE_PER_MIN=6
RATE_PER_DAY=40
GLOBAL_PER_DAY=800
